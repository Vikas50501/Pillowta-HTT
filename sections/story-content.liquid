{% comment %}
  Reusable long-form editorial/brand-story section. Built for the "Our Story"
  page as a set of deliberately different visual treatments per block type,
  not one repeated card pattern: `chapter` blocks run down a timeline rail
  (badge + connecting line) with an optional scroll-revealed lead image,
  `highlight` blocks are hover-interactive icon cards grouped into a grid
  when they appear back-to-back, and `quote_cta` blocks are layered
  signature-quote callouts that alternate a plain/tinted background so two
  in a row don't look identical. Colors/spacing are schema-driven so it
  stays on the theme's existing design tokens. Any other long-form content
  page can reuse this section the same way.
{% endcomment %}
<div
  id="shopify-section-{{ section.id }}"
  class="story-content{% if section.settings.font_override != 'inherit' %} story-content--font-{{ section.settings.font_override }}{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="story-content"
  style="
    {%- if section.settings.background_color != blank -%}--story-bg: {{ section.settings.background_color }};{%- endif -%}
    {%- if section.settings.heading_color != blank -%}--story-heading-color: {{ section.settings.heading_color }};{%- endif -%}
    {%- if section.settings.text_color != blank -%}--story-text-color: {{ section.settings.text_color }};{%- endif -%}
    {%- if section.settings.accent_color != blank -%}--story-accent-color: {{ section.settings.accent_color }};{%- endif -%}
    --story-padding-top: {{ section.settings.section_padding_top }}px;
    --story-padding-bottom: {{ section.settings.section_padding_bottom }}px;
    --story-chapter-gap: {{ section.settings.chapter_gap }}px;
    --story-content-width: {{ section.settings.content_max_width }}px;
  "
>
  <div class="story-content__inner page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
      <header class="story-content__header{% if section.settings.header_image != blank %} story-content__header--split{% endif %}" data-scroll-reveal>
        <span class="story-content__header-glow" aria-hidden="true"></span>
        <div class="story-content__header-text">
          {%- if section.settings.eyebrow != blank -%}
            <p class="story-content__eyebrow">
              {%- render 'icon', name: 'spark', icon_size: 14 -%}
              {{ section.settings.eyebrow }}
            </p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h1 class="story-content__heading">{{ section.settings.heading }}</h1>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <div class="story-content__intro">{{ section.settings.intro }}</div>
          {%- endif -%}
        </div>
        {%- if section.settings.header_image != blank -%}
          <div class="story-content__header-image">
            {{ section.settings.header_image | image_url: width: 900 | image_tag: widths: '450,700,900', alt: section.settings.heading | default: '', loading: 'lazy' }}
          </div>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="story-content__timeline">
      {%- liquid
        assign chapter_count = 0
        assign quote_count = 0
      -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign prev_type = ''
          assign next_type = ''
          assign prev_index = forloop.index0 | minus: 1
          if forloop.index0 > 0
            assign prev_block = section.blocks[prev_index]
            assign prev_type = prev_block.type
          endif
          if forloop.index < section.blocks.size
            assign next_block = section.blocks[forloop.index]
            assign next_type = next_block.type
          endif
        -%}
        {%- case block.type -%}

          {%- when 'chapter' -%}
            {%- assign chapter_count = chapter_count | plus: 1 -%}
            <article class="story-content__chapter{% if forloop.last %} story-content__chapter--last{% endif %}" data-scroll-reveal {{ block.shopify_attributes }}>
              <div class="story-content__rail" aria-hidden="true">
                <span class="story-content__badge">{{ block.settings.number | default: chapter_count }}</span>
                <span class="story-content__rail-line"></span>
              </div>
              <div class="story-content__chapter-content">
                {%- if block.settings.eyebrow != blank -%}
                  <p class="story-content__chapter-eyebrow">{{ block.settings.eyebrow }}</p>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="story-content__chapter-heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.image != blank -%}
                  <div class="story-content__chapter-image">
                    <div class="story-content__chapter-image-mask">
                      {{ block.settings.image | image_url: width: 900 | image_tag: widths: '450,700,900', alt: block.settings.heading | default: '', loading: 'lazy' }}
                    </div>
                  </div>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <div class="story-content__chapter-text">{{ block.settings.body }}</div>
                {%- endif -%}
                {%- if block.settings.pull_quote != blank -%}
                  <blockquote class="story-content__pull-quote">
                    <span class="story-content__pull-quote-mark" aria-hidden="true">&ldquo;</span>
                    {{ block.settings.pull_quote }}
                  </blockquote>
                {%- endif -%}
              </div>
            </article>

          {%- when 'highlight' -%}
            {%- if prev_type != 'highlight' -%}<div class="story-content__highlights">{%- endif -%}
              {%- assign highlight_icon = block.settings.icon | default: 'spark' -%}
              <div class="story-content__highlight" {{ block.shopify_attributes }}>
                <span class="story-content__highlight-icon">
                  {%- render 'icon', name: highlight_icon, icon_size: 24 -%}
                </span>
                {%- if block.settings.title != blank -%}
                  <p class="story-content__highlight-title">{{ block.settings.title }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="story-content__highlight-text">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            {%- if next_type != 'highlight' -%}</div>{%- endif -%}

          {%- when 'quote_cta' -%}
            {%- liquid
              assign quote_count = quote_count | plus: 1
              assign quote_is_even = quote_count | modulo: 2
              assign quote_reverse = false
              if quote_is_even == 0
                assign quote_reverse = true
              endif
              assign quote_has_media = false
              if block.settings.background_image != blank or block.settings.background_video != blank
                assign quote_has_media = true
              endif
              assign quote_tinted = false
              if quote_reverse and quote_has_media == false
                assign quote_tinted = true
              endif
            -%}
            <div
              class="story-signature{% if quote_reverse %} story-signature--reverse{% endif %}{% if quote_has_media %} story-signature--media{% endif %}{% if quote_tinted %} story-signature--tinted{% endif %}"
              data-scroll-reveal
              data-story-signature
              {{ block.shopify_attributes }}
            >
              {%- if quote_has_media -%}
                <div class="story-signature__media" data-story-signature-media>
                  {%- if block.settings.background_video != blank -%}
                    {{ block.settings.background_video | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false, class: 'story-signature__media-el' }}
                  {%- else -%}
                    {{ block.settings.background_image | image_url: width: 1600 | image_tag: widths: '800,1200,1600', alt: '', loading: 'lazy', class: 'story-signature__media-el' }}
                  {%- endif -%}
                  <span class="story-signature__overlay" aria-hidden="true"></span>
                </div>
              {%- endif -%}

              <span class="story-signature__blob story-signature__blob--a" aria-hidden="true"></span>
              <span class="story-signature__blob story-signature__blob--b" aria-hidden="true"></span>
              <span class="story-signature__spotlight" data-story-signature-spotlight aria-hidden="true"></span>

              <div class="story-signature__content">
                <svg class="story-signature__mark" viewBox="0 0 48 32" aria-hidden="true" focusable="false">
                  <path d="M4 32V19.4C4 9.3 9.9 2.4 20 0l1.6 4.7C15 6.8 11.6 11 11.6 16.8h7.9V32H4Zm22 0V19.4C26 9.3 31.9 2.4 42 0l1.6 4.7C37 6.8 33.6 11 33.6 16.8h7.9V32H26Z"/>
                </svg>
                {%- if block.settings.quote != blank -%}
                  <p class="story-signature__quote">{{ block.settings.quote }}</p>
                {%- endif -%}
                {%- if block.settings.attribution != blank -%}
                  <p class="story-signature__attribution">{{ block.settings.attribution }}</p>
                {%- endif -%}
                {%- if block.settings.button_text != blank -%}
                  <a href="{{ block.settings.button_link | default: '#' }}" class="action action--secondary story-signature__button" data-magnetic-button>
                    <span class="story-signature__button-label">{{ block.settings.button_text }}</span>
                    {%- render 'icon', name: 'arrow-right', icon_size: 14 -%}
                  </a>
                {%- endif -%}
              </div>
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .story-content {
    padding-top: var(--story-padding-top, var(--section-spacing));
    padding-bottom: var(--story-padding-bottom, var(--section-spacing));
    background-color: var(--story-bg, transparent);
    color: var(--story-text-color, inherit);
    overflow: hidden;
  }

  .story-content__inner {
    max-width: var(--story-content-width, 47.5rem);
    position: relative;
  }

  /* ---- Header ---- */
  .story-content__header {
    position: relative;
    text-align: center;
    margin-bottom: var(--story-chapter-gap, 4rem);
  }

  .story-content__header-glow {
    position: absolute;
    top: -6rem;
    left: 50%;
    width: 26rem;
    height: 26rem;
    margin-left: -13rem;
    border-radius: 50%;
    background: var(--story-accent-color, rgb(var(--color-accent)));
    opacity: .12;
    filter: blur(70px);
    z-index: -1;
    animation: story-glow-float 14s ease-in-out infinite;
  }

  .story-content__header--split {
    display: flex;
    align-items: center;
    gap: 3rem;
    text-align: left;
    max-width: none;
  }

  .story-content__header--split .story-content__header-text {
    flex: 1;
  }

  .story-content__header-image {
    flex: 0 0 40%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transform: rotate(-1.5deg);
    transition: transform var(--transition-medium);
  }

  .story-content__header-image:hover {
    transform: rotate(0deg) scale(1.02);
  }

  .story-content__header-image img {
    width: 100%;
    display: block;
  }

  .story-content__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--story-accent-color, rgb(var(--color-accent)));
    margin: 0 0 .75rem;
  }

  .story-content__eyebrow svg {
    flex-shrink: 0;
  }

  .story-content__heading {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--font-size-h1);
    color: var(--story-heading-color, rgb(var(--color-heading)));
    margin: 0 0 1rem;
  }

  .story-content__intro {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-base);
    color: rgba(var(--color-text), .75);
  }

  /* ---- Timeline / chapters ---- */
  .story-content__timeline {
    position: relative;
  }

  .story-content__chapter {
    display: flex;
    gap: 1.75rem;
    margin-bottom: var(--story-chapter-gap, 4rem);
  }

  .story-content__rail {
    flex: 0 0 2.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .story-content__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--story-accent-color, rgb(var(--color-accent)));
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--font-size-small);
    color: var(--story-accent-color, rgb(var(--color-accent)));
    flex-shrink: 0;
  }

  .story-content__rail-line {
    flex: 1;
    width: 1px;
    margin-top: .75rem;
    background: linear-gradient(to bottom, var(--story-accent-color, rgb(var(--color-accent))), transparent);
    opacity: .4;
  }

  .story-content__chapter--last .story-content__rail-line {
    display: none;
  }

  .story-content__chapter-content {
    flex: 1;
    min-width: 0;
  }

  .story-content__chapter-eyebrow {
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--story-accent-color, rgb(var(--color-accent)));
    margin: 0 0 .5rem;
  }

  .story-content__chapter-heading {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--font-size-h2);
    color: var(--story-heading-color, rgb(var(--color-heading)));
    margin: 0 0 1rem;
    text-transform: lowercase;
  }

  .story-content__chapter-image {
    margin: 0 0 1.25rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .story-content__chapter-image-mask {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1s var(--transition-medium, ease);
  }

  .story-content__chapter.is-revealed .story-content__chapter-image-mask {
    clip-path: inset(0 0 0 0);
  }

  .story-content__chapter-image img {
    width: 100%;
    display: block;
  }

  .story-content__chapter-text {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
  }

  .story-content__chapter-text p + p {
    margin-top: 1rem;
  }

  .story-content__pull-quote {
    position: relative;
    margin: 1.5rem 0 0;
    padding: 1.25rem 1.5rem 1.25rem 1.75rem;
    background: rgb(var(--color-background-alt));
    border-left: 3px solid var(--story-accent-color, rgb(var(--color-accent)));
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--font-size-h3);
    line-height: 1.4;
    transition: transform var(--transition-medium), box-shadow var(--transition-medium);
  }

  .story-content__pull-quote:hover {
    transform: translateX(4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, .06);
  }

  .story-content__pull-quote-mark {
    color: var(--story-accent-color, rgb(var(--color-accent)));
    opacity: .5;
    margin-right: .15em;
  }

  /* ---- Highlight cards ---- */
  .story-content__highlights {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: var(--story-chapter-gap, 4rem);
  }

  .story-content__highlight {
    padding: 1.75rem 1.5rem;
    background: rgb(var(--color-background-alt));
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    transition: transform var(--transition-medium), box-shadow var(--transition-medium), border-color var(--transition-medium);
  }

  .story-content__highlight:hover {
    transform: translateY(-6px);
    border-color: var(--story-accent-color, rgb(var(--color-accent)));
    box-shadow: 0 16px 32px rgba(0, 0, 0, .08);
  }

  .story-content__highlight-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 1rem;
    border-radius: 50%;
    background: rgb(var(--color-background));
    color: var(--story-accent-color, rgb(var(--color-accent)));
    transition: transform var(--transition-medium);
  }

  .story-content__highlight:hover .story-content__highlight-icon {
    transform: rotate(-8deg) scale(1.08);
  }

  .story-content__highlight-title {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--font-size-h3);
    margin: 0 0 .5rem;
  }

  .story-content__highlight-text {
    font-size: var(--font-size-small);
    line-height: var(--line-height-base);
    color: rgba(var(--color-text), .75);
  }

  /* ---- Signature quote / CTA ---- */
  .story-signature {
    position: relative;
    isolation: isolate;
    text-align: center;
    padding: 3.5rem 2rem;
    margin-bottom: var(--story-chapter-gap, 4rem);
    border-radius: var(--radius-lg);
    border: 1px solid rgb(var(--color-border));
    overflow: hidden;
  }

  .story-signature--tinted {
    background: rgba(var(--color-accent), .06);
    border-color: transparent;
  }

  .story-signature--media {
    min-height: 26rem;
    display: flex;
    align-items: center;
    padding: 5rem 2.5rem;
    border: 0;
    color: #fff;
    text-align: left;
  }

  .story-signature__media {
    position: absolute;
    inset: -12% 0;
    z-index: -2;
  }

  .story-signature__media-el {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    will-change: transform;
  }

  .story-signature__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, .3), rgba(0, 0, 0, .6));
  }

  .story-signature__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: .16;
    z-index: -1;
    pointer-events: none;
  }

  .story-signature__blob--a {
    top: -4rem;
    left: -3rem;
    width: 14rem;
    height: 14rem;
    background: var(--story-accent-color, rgb(var(--color-accent)));
    animation: story-glow-float 16s ease-in-out infinite;
  }

  .story-signature__blob--b {
    bottom: -5rem;
    right: -4rem;
    width: 18rem;
    height: 18rem;
    background: var(--story-accent-color, rgb(var(--color-accent)));
    animation: story-glow-float 20s ease-in-out infinite reverse;
  }

  .story-signature--media .story-signature__blob {
    display: none;
  }

  .story-signature__spotlight {
    display: none;
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(18rem circle at var(--spot-x, 50%) var(--spot-y, 50%), rgba(255, 255, 255, .16), transparent 70%);
    transition: opacity .3s ease;
  }

  .story-signature--media .story-signature__spotlight {
    display: block;
  }

  .story-signature--media:hover .story-signature__spotlight {
    opacity: 1;
  }

  .story-signature__content {
    position: relative;
    z-index: 1;
    max-width: 30rem;
    margin-inline: auto;
  }

  .story-signature--media .story-signature__content {
    margin-inline: 0 auto;
  }

  .story-signature--media.story-signature--reverse .story-signature__content {
    margin-inline: auto 0;
    text-align: right;
  }

  .story-signature__mark {
    width: 2.75rem;
    height: 1.85rem;
    margin-bottom: 1rem;
    fill: currentColor;
    color: var(--story-accent-color, rgb(var(--color-accent)));
    opacity: 0;
    transform: scale(.5);
    transition: opacity .6s ease, transform .6s ease;
  }

  .story-signature--media .story-signature__mark {
    color: #fff;
  }

  .story-signature.is-revealed .story-signature__mark {
    opacity: 1;
    transform: scale(1);
  }

  .story-signature__quote {
    position: relative;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--font-size-h2);
    line-height: 1.4;
    margin: 0 0 1rem;
    opacity: 0;
    transform: scale(.96);
    transition: opacity .8s ease .1s, transform .8s ease .1s;
  }

  .story-signature.is-revealed .story-signature__quote {
    opacity: 1;
    transform: scale(1);
  }

  .story-signature__attribution {
    font-size: var(--font-size-caption);
    text-transform: uppercase;
    letter-spacing: .08em;
    color: rgba(var(--color-text), .6);
    margin: 0 0 1.5rem;
  }

  .story-signature--media .story-signature__attribution {
    color: rgba(255, 255, 255, .75);
  }

  .story-signature__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    overflow: hidden;
    transition: transform .2s ease;
  }

  .story-signature__button svg {
    transition: transform var(--transition-fast);
  }

  .story-signature__button:hover svg {
    transform: translateX(4px);
  }

  .story-signature__button-ripple {
    position: absolute;
    border-radius: 50%;
    background: rgba(var(--color-text), .25);
    transform: scale(0);
    opacity: .6;
    pointer-events: none;
    animation: story-signature-ripple .6s ease-out forwards;
  }

  .story-signature--media .story-signature__button-ripple {
    background: rgba(255, 255, 255, .5);
  }

  @keyframes story-signature-ripple {
    to {
      transform: scale(3);
      opacity: 0;
    }
  }

  @keyframes story-glow-float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(1.5rem, 1rem) scale(1.1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-content__header-glow,
    .story-signature__blob {
      animation: none;
    }

    .story-signature__mark,
    .story-signature__quote {
      transition: none;
    }
  }

  @media screen and (max-width: 59.99em) {
    .story-content__header--split {
      flex-direction: column;
      text-align: center;
    }

    .story-content__header-image {
      flex: none;
      width: 100%;
      order: -1;
    }

    .story-content__highlights {
      grid-template-columns: 1fr;
    }

    .story-content__heading {
      font-size: var(--font-size-h1-mobile);
    }

    .story-content__intro {
      font-size: var(--font-size-body);
    }

    .story-signature--media {
      min-height: 20rem;
      padding: 3rem 1.5rem;
      text-align: center;
    }

    .story-signature--media .story-signature__content,
    .story-signature--media.story-signature--reverse .story-signature__content {
      margin-inline: auto;
      text-align: center;
    }
  }

  @media screen and (max-width: 34.99em) {
    .story-content__chapter {
      gap: 1rem;
    }

    .story-content__rail {
      flex: 0 0 2rem;
    }

    .story-content__badge {
      width: 2rem;
      height: 2rem;
      font-size: var(--font-size-caption);
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    document.querySelectorAll('[data-story-signature]').forEach(function (card) {
      var mediaWrap = card.querySelector('[data-story-signature-media]');
      var mediaEl = mediaWrap ? mediaWrap.querySelector('img, video') : null;

      if (mediaEl && !prefersReducedMotion) {
        var ticking = false;
        var updateParallax = function () {
          var rect = card.getBoundingClientRect();
          var viewportHeight = window.innerHeight || document.documentElement.clientHeight;
          var progress = (viewportHeight - rect.top) / (viewportHeight + rect.height);
          var offset = (progress - 0.5) * 40;
          mediaEl.style.transform = 'translateY(' + offset + 'px)';
          ticking = false;
        };
        var onScroll = function () {
          if (!ticking) {
            ticking = true;
            window.requestAnimationFrame(updateParallax);
          }
        };
        var parallaxObserver = new IntersectionObserver(function (entries) {
          if (entries[0].isIntersecting) {
            updateParallax();
            window.addEventListener('scroll', onScroll, { passive: true });
          } else {
            window.removeEventListener('scroll', onScroll);
          }
        });
        parallaxObserver.observe(card);
      }

      if (canHover) {
        var spotlight = card.querySelector('[data-story-signature-spotlight]');
        if (spotlight) {
          card.addEventListener('mousemove', function (e) {
            var rect = card.getBoundingClientRect();
            var x = ((e.clientX - rect.left) / rect.width) * 100;
            var y = ((e.clientY - rect.top) / rect.height) * 100;
            card.style.setProperty('--spot-x', x + '%');
            card.style.setProperty('--spot-y', y + '%');
          });
        }
      }

      var button = card.querySelector('[data-magnetic-button]');
      if (button) {
        if (canHover && !prefersReducedMotion) {
          button.addEventListener('mousemove', function (e) {
            var rect = button.getBoundingClientRect();
            var x = e.clientX - rect.left - rect.width / 2;
            var y = e.clientY - rect.top - rect.height / 2;
            button.style.transform = 'translate(' + (x * 0.25) + 'px, ' + (y * 0.25) + 'px)';
          });
          button.addEventListener('mouseleave', function () {
            button.style.transform = 'translate(0, 0)';
          });
        }

        button.addEventListener('click', function (e) {
          var rect = button.getBoundingClientRect();
          var size = Math.max(rect.width, rect.height);
          var ripple = document.createElement('span');
          ripple.className = 'story-signature__button-ripple';
          ripple.style.width = size + 'px';
          ripple.style.height = size + 'px';
          ripple.style.left = (e.clientX - rect.left - size / 2) + 'px';
          ripple.style.top = (e.clientY - rect.top - size / 2) + 'px';
          button.appendChild(ripple);
          ripple.addEventListener('animationend', function () {
            ripple.remove();
          });
        });
      }
    });
  })();
