{% comment %}
  Reusable long-form campaign/landing section for content-heavy marketing
  pages (built for "Co-Create With Us", reusable for any future survey/
  community campaign page). Deliberately different visual patterns from
  story-content.liquid's timeline/chapter treatment: an asymmetric hero
  with an animated count-up statistic, a horizontal connected process
  flow, a left-aligned value-prop list, a simple centered testimonial, a
  layered image+badge spotlight CTA, an icon-card privacy grid, and a
  native accordion FAQ - each its own block type so merchants can add,
  remove, and reorder freely. A single `cta_banner` block type re-shows
  the section-level survey button wherever the content called for a
  repeated CTA, without retyping the link every time.
{% endcomment %}
<div
  id="shopify-section-{{ section.id }}"
  class="cocreate{% if section.settings.font_override != 'inherit' %} cocreate--font-{{ section.settings.font_override }}{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="cocreate"
  style="
    {%- if section.settings.background_color != blank -%}--cocreate-bg: {{ section.settings.background_color }};{%- endif -%}
    {%- if section.settings.heading_color != blank -%}--cocreate-heading-color: {{ section.settings.heading_color }};{%- endif -%}
    {%- if section.settings.text_color != blank -%}--cocreate-text-color: {{ section.settings.text_color }};{%- endif -%}
    {%- if section.settings.accent_color != blank -%}--cocreate-accent-color: {{ section.settings.accent_color }};{%- endif -%}
    --cocreate-padding-top: {{ section.settings.section_padding_top }}px;
    --cocreate-padding-bottom: {{ section.settings.section_padding_bottom }}px;
    --cocreate-block-gap: {{ section.settings.block_gap }}px;
    --cocreate-content-width: {{ section.settings.content_max_width }}px;
  "
>
  <div class="cocreate__inner page-width">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      {%- assign hero_has_image = false -%}
      {%- if section.settings.hero_image != blank -%}{%- assign hero_has_image = true -%}{%- endif -%}
      <div class="cocreate__hero{% if hero_has_image %} cocreate__hero--with-image{% endif %}" data-scroll-reveal>
        <span class="cocreate__hero-blob cocreate__hero-blob--a" aria-hidden="true"></span>
        <span class="cocreate__hero-blob cocreate__hero-blob--b" aria-hidden="true"></span>
        <div class="cocreate__hero-text">
          {%- if section.settings.eyebrow != blank -%}
            <p class="cocreate__eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h1 class="cocreate__heading">{{ section.settings.heading }}</h1>
          {%- endif -%}
          {%- if section.settings.subtext != blank -%}
            <div class="cocreate__subtext">{{ section.settings.subtext }}</div>
          {%- endif -%}
          {%- if section.settings.survey_button_text != blank -%}
            <a href="{{ section.settings.survey_link | default: '#' }}" class="action action--primary cocreate__cta">
              {{ section.settings.survey_button_text }}
            </a>
          {%- endif -%}
          {%- if hero_has_image == false and section.settings.stat_number != blank -%}
            <div class="cocreate__stat cocreate__stat--inline">
              <span class="cocreate__stat-number" data-cocreate-stat="{{ section.settings.stat_number }}">{{ section.settings.stat_number }}</span>
              {%- if section.settings.stat_label != blank -%}
                <p class="cocreate__stat-label">{{ section.settings.stat_label }}</p>
              {%- endif -%}
              {%- if section.settings.stat_caption != blank -%}
                <p class="cocreate__stat-caption">{{ section.settings.stat_caption }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
        {%- if hero_has_image -%}
          <div class="cocreate__hero-media">
            {{ section.settings.hero_image | image_url: width: 900 | image_tag: widths: '450,700,900', alt: section.settings.heading | default: '', loading: 'lazy', class: 'cocreate__hero-image' }}
            {%- if section.settings.stat_number != blank -%}
              <div class="cocreate__stat cocreate__stat--floating">
                <span class="cocreate__stat-number" data-cocreate-stat="{{ section.settings.stat_number }}">{{ section.settings.stat_number }}</span>
                {%- if section.settings.stat_label != blank -%}
                  <p class="cocreate__stat-label">{{ section.settings.stat_label }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- liquid
        assign prev_type = ''
        assign next_type = ''
        assign prev_index = forloop.index0 | minus: 1
        if forloop.index0 > 0
          assign prev_block = section.blocks[prev_index]
          assign prev_type = prev_block.type
        endif
        if forloop.index < section.blocks.size
          assign next_block = section.blocks[forloop.index]
          assign next_type = next_block.type
        endif
      -%}
      {%- case block.type -%}

        {%- when 'intro_statement' -%}
          {%- assign statement_has_image = false -%}
          {%- if block.settings.image != blank -%}{%- assign statement_has_image = true -%}{%- endif -%}
          <div class="cocreate__statement{% if statement_has_image %} cocreate__statement--with-image{% endif %}" data-scroll-reveal {{ block.shopify_attributes }}>
            {%- if statement_has_image -%}
              <div class="cocreate__statement-media">
                {{ block.settings.image | image_url: width: 700 | image_tag: widths: '350,500,700', alt: block.settings.heading | default: '', loading: 'lazy' }}
              </div>
            {%- endif -%}
            <div class="cocreate__statement-copy">
              <span class="cocreate__statement-mark" aria-hidden="true">&ldquo;</span>
              {%- if block.settings.heading != blank -%}
                <h2 class="cocreate__statement-heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <div class="cocreate__statement-body">{{ block.settings.body }}</div>
              {%- endif -%}
            </div>
          </div>

        {%- when 'value_prop' -%}
          {%- if prev_type != 'value_prop' -%}
            <div class="cocreate__values" data-scroll-reveal>
            {%- assign value_index = 0 -%}
          {%- endif -%}
            {%- assign value_index = value_index | plus: 1 -%}
            {%- assign value_has_image = false -%}
            {%- if block.settings.image != blank -%}{%- assign value_has_image = true -%}{%- endif -%}
            <div class="cocreate__value{% if value_index == 1 %} cocreate__value--featured{% endif %}{% if value_has_image %} cocreate__value--with-image{% endif %}" {{ block.shopify_attributes }}>
              {%- if value_has_image -%}
                <div class="cocreate__value-media">
                  {{ block.settings.image | image_url: width: 500 | image_tag: widths: '250,400,500', alt: block.settings.lead | default: '', loading: 'lazy' }}
                </div>
              {%- endif -%}
              <div class="cocreate__value-copy">
                {%- if block.settings.icon != blank -%}
                  <span class="cocreate__value-icon" aria-hidden="true">{{ block.settings.icon }}</span>
                {%- endif -%}
                {%- if block.settings.lead != blank -%}
                  <span class="cocreate__value-lead">{{ block.settings.lead }}</span>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="cocreate__value-text">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- if next_type != 'value_prop' -%}</div>{%- endif -%}

        {%- when 'process_step' -%}
          {%- if prev_type != 'process_step' -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="cocreate__section-heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            <div class="cocreate__process">
          {%- endif -%}
            {%- assign step_has_image = false -%}
            {%- if block.settings.image != blank -%}{%- assign step_has_image = true -%}{%- endif -%}
            <div class="cocreate__step{% if step_has_image %} cocreate__step--with-image{% endif %}{% if next_type != 'process_step' %} cocreate__step--last{% endif %}" data-scroll-reveal {{ block.shopify_attributes }}>
              {%- if step_has_image -%}
                <div class="cocreate__step-media">
                  {{ block.settings.image | image_url: width: 500 | image_tag: widths: '250,400,500', alt: block.settings.title | default: '', loading: 'lazy' }}
                </div>
              {%- endif -%}
              <div class="cocreate__step-rail" aria-hidden="true">
                <span class="cocreate__step-number">{{ block.settings.number }}</span>
                <span class="cocreate__step-line"></span>
              </div>
              <div class="cocreate__step-copy">
                {%- if block.settings.title != blank -%}
                  <p class="cocreate__step-title">{{ block.settings.title }}</p>
                {%- endif -%}
                {%- if block.settings.subtitle != blank -%}
                  <p class="cocreate__step-subtitle">{{ block.settings.subtitle }}</p>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <div class="cocreate__step-description">{{ block.settings.description }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- if next_type != 'process_step' -%}</div>{%- endif -%}

        {%- when 'testimonial' -%}
          <div class="cocreate__testimonial-wrap" data-scroll-reveal {{ block.shopify_attributes }}>
            <span class="cocreate__testimonial-shape" aria-hidden="true"></span>
            {%- if block.settings.image != blank -%}
              <div class="cocreate__testimonial-portrait">
                {{ block.settings.image | image_url: width: 160 | image_tag: widths: '80,160', alt: block.settings.attribution | default: '', loading: 'lazy' }}
              </div>
            {%- endif -%}
            <blockquote class="cocreate__testimonial">
              {%- if block.settings.quote != blank -%}
                <p class="cocreate__testimonial-quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
              {%- endif -%}
              {%- if block.settings.attribution != blank -%}
                <cite class="cocreate__testimonial-attribution">{{ block.settings.attribution }}</cite>
              {%- endif -%}
            </blockquote>
          </div>

        {%- when 'spotlight_cta' -%}
          {%- assign spotlight_has_image = false -%}
          {%- if block.settings.image != blank -%}{%- assign spotlight_has_image = true -%}{%- endif -%}
          <div class="cocreate__spotlight{% if spotlight_has_image == false %} cocreate__spotlight--no-image{% endif %}" data-scroll-reveal {{ block.shopify_attributes }}>
            {%- if spotlight_has_image -%}
              <div class="cocreate__spotlight-media{% if block.settings.image_2 != blank %} cocreate__spotlight-media--stacked{% endif %}">
                {%- if block.settings.image_2 != blank -%}
                  <div class="cocreate__spotlight-media-back">
                    {{ block.settings.image_2 | image_url: width: 900 | image_tag: widths: '450,700,900', alt: '', loading: 'lazy' }}
                  </div>
                {%- endif -%}
                <div class="cocreate__spotlight-media-front">
                  {{ block.settings.image | image_url: width: 900 | image_tag: widths: '450,700,900', alt: block.settings.badge_title | default: '', loading: 'lazy' }}
                  {%- if block.settings.badge_icon != blank -%}
                    <span class="cocreate__spotlight-badge">
                      <span class="cocreate__spotlight-badge-icon" aria-hidden="true">{{ block.settings.badge_icon }}</span>
                      {%- if block.settings.badge_title != blank -%}
                        <span class="cocreate__spotlight-badge-title">{{ block.settings.badge_title }}</span>
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
            <div class="cocreate__spotlight-content">
              {%- if block.settings.badge_subtext != blank -%}
                <p class="cocreate__spotlight-subtext">{{ block.settings.badge_subtext }}</p>
              {%- endif -%}
              {%- if block.settings.benefit_line_1 != blank or block.settings.benefit_line_2 != blank or block.settings.benefit_line_3 != blank -%}
                <ul class="cocreate__spotlight-benefits">
                  {%- if block.settings.benefit_line_1 != blank -%}<li>{{ block.settings.benefit_line_1 }}</li>{%- endif -%}
                  {%- if block.settings.benefit_line_2 != blank -%}<li>{{ block.settings.benefit_line_2 }}</li>{%- endif -%}
                  {%- if block.settings.benefit_line_3 != blank -%}<li>{{ block.settings.benefit_line_3 }}</li>{%- endif -%}
                </ul>
              {%- endif -%}
              {%- if block.settings.closing_text != blank -%}
                <div class="cocreate__spotlight-closing">{{ block.settings.closing_text }}</div>
              {%- endif -%}
              <div class="cocreate__spotlight-actions">
                {%- if section.settings.survey_button_text != blank -%}
                  <a href="{{ section.settings.survey_link | default: '#' }}" class="action action--primary">
                    {{ section.settings.survey_button_text }}
                  </a>
                {%- endif -%}
                {%- if block.settings.secondary_link_text != blank -%}
                  <a href="{{ block.settings.secondary_link_url | default: '#' }}" class="cocreate__spotlight-secondary-link">
                    {{ block.settings.secondary_link_text }}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>

        {%- when 'privacy_item' -%}
          {%- if prev_type != 'privacy_item' -%}
            <div class="cocreate__privacy-section">
              <span class="cocreate__privacy-texture" aria-hidden="true"></span>
              {%- if block.settings.heading != blank -%}
                <h2 class="cocreate__section-heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <p class="cocreate__section-subheading">{{ block.settings.subheading }}</p>
              {%- endif -%}
              <div class="cocreate__privacy-grid" data-scroll-reveal>
          {%- endif -%}
            <div class="cocreate__privacy-item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="cocreate__privacy-icon" aria-hidden="true">{{ block.settings.icon }}</span>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <p class="cocreate__privacy-title">{{ block.settings.title }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="cocreate__privacy-text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          {%- if next_type != 'privacy_item' -%}
              </div>
            </div>
          {%- endif -%}

        {%- when 'faq_item' -%}
          {%- if prev_type != 'faq_item' -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="cocreate__section-heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            <div class="cocreate__faq">
          {%- endif -%}
            <details class="cocreate__faq-item" {{ block.shopify_attributes }}>
              <summary class="cocreate__faq-question">
                {{ block.settings.question }}
                <span class="cocreate__faq-toggle" aria-hidden="true"></span>
              </summary>
              <div class="cocreate__faq-answer">{{ block.settings.answer }}</div>
            </details>
          {%- if next_type != 'faq_item' -%}</div>{%- endif -%}

        {%- when 'cta_banner' -%}
          {%- if section.settings.survey_button_text != blank -%}
            <div class="cocreate__cta-banner" data-scroll-reveal {{ block.shopify_attributes }}>
              <span class="cocreate__cta-banner-glow" aria-hidden="true"></span>
              <a href="{{ section.settings.survey_link | default: '#' }}" class="action action--primary">
                {{ section.settings.survey_button_text }}
              </a>
            </div>
          {%- endif -%}

      {%- endcase -%}
    {%- endfor -%}

  </div>
</div>

{% stylesheet %}
  .cocreate {
    padding-top: var(--cocreate-padding-top, var(--section-spacing));
    padding-bottom: var(--cocreate-padding-bottom, var(--section-spacing));
    background-color: var(--cocreate-bg, transparent);
    color: var(--cocreate-text-color, inherit);
  }

  .cocreate__inner {
    max-width: var(--cocreate-content-width, 67.5rem);
  }

  .cocreate .action--primary {
    margin-top: 1.5rem;
  }

  @keyframes cocreate-blob-float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(1.25rem, 1rem) scale(1.08); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cocreate__hero-blob,
    .cocreate__cta-banner-glow {
      animation: none;
    }
  }

  /* ---- Hero ---- */
  .cocreate__hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: var(--cocreate-block-gap, 4rem);
  }

  .cocreate__hero--with-image {
    align-items: center;
  }

  .cocreate__hero-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: .14;
    z-index: -1;
    pointer-events: none;
    background: var(--cocreate-accent-color, rgb(var(--color-accent)));
  }

  .cocreate__hero-blob--a {
    top: -3rem;
    left: -2rem;
    width: 16rem;
    height: 16rem;
    animation: cocreate-blob-float 15s ease-in-out infinite;
  }

  .cocreate__hero-blob--b {
    bottom: -4rem;
    right: 10%;
    width: 12rem;
    height: 12rem;
    animation: cocreate-blob-float 18s ease-in-out infinite reverse;
  }

  .cocreate__hero-text {
    position: relative;
    z-index: 1;
    flex: 1;
    max-width: 34rem;
  }

  .cocreate__eyebrow {
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--cocreate-accent-color, rgb(var(--color-accent)));
    margin: 0 0 .75rem;
  }

  .cocreate__heading {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--font-size-h1);
    color: var(--cocreate-heading-color, rgb(var(--color-heading)));
    margin: 0 0 1rem;
  }

  .cocreate__subtext {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
    color: rgba(var(--color-text), .75);
  }

  .cocreate__cta {
    display: inline-flex;
  }

  .cocreate__hero-media {
    position: relative;
    z-index: 1;
    flex: 0 0 26rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 24px 48px rgba(0, 0, 0, .12);
    transform: rotate(-1.5deg);
    transition: transform var(--transition-medium);
  }

  .cocreate__hero-media:hover {
    transform: rotate(0deg) scale(1.015);
  }

  .cocreate__hero-image {
    width: 100%;
    display: block;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .cocreate__stat--inline {
    flex: 0 0 auto;
    text-align: right;
    margin-top: 1.5rem;
    padding-left: 2rem;
    border-left: 1px solid rgb(var(--color-border));
  }

  .cocreate__stat--floating {
    position: absolute;
    bottom: 1.25rem;
    left: -1.5rem;
    max-width: 11rem;
    padding: 1rem 1.25rem;
    background: rgb(var(--color-background));
    border-radius: var(--radius-lg);
    box-shadow: 0 16px 32px rgba(0, 0, 0, .16);
  }

  .cocreate__stat-number {
    display: block;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 3.5rem;
    line-height: 1;
    color: var(--cocreate-accent-color, rgb(var(--color-accent)));
  }

  .cocreate__stat--floating .cocreate__stat-number {
    font-size: 2.25rem;
  }

  .cocreate__stat-label {
    font-size: var(--font-size-small);
    max-width: 12rem;
    margin: .5rem 0 0;
  }

  .cocreate__stat-caption {
    font-size: var(--font-size-caption);
    color: rgba(var(--color-text), .6);
    max-width: 12rem;
    margin: .5rem 0 0;
  }

  /* ---- Statement (overlapping layered composition) ---- */
  .cocreate__statement {
    position: relative;
    max-width: 40rem;
    margin: 0 auto var(--cocreate-block-gap, 4rem);
    padding-top: 1rem;
  }

  .cocreate__statement--with-image {
    padding-left: 3rem;
    padding-top: 2.5rem;
  }

  .cocreate__statement-media {
    position: absolute;
    top: 0;
    left: -1rem;
    width: 8rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transform: rotate(-6deg);
    box-shadow: 0 16px 32px rgba(0, 0, 0, .14);
    z-index: 0;
  }

  .cocreate__statement-media img {
    width: 100%;
    display: block;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .cocreate__statement-copy {
    position: relative;
    z-index: 1;
    text-align: center;
    background: rgb(var(--color-background));
    border-radius: var(--radius-lg);
  }

  .cocreate__statement--with-image .cocreate__statement-copy {
    text-align: left;
    padding: 2rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, .08);
  }

  .cocreate__statement-mark {
    display: none;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 3.5rem;
    line-height: 1;
    color: var(--cocreate-accent-color, rgb(var(--color-accent)));
    opacity: .35;
  }

  .cocreate__statement--with-image .cocreate__statement-mark {
    display: block;
    margin-bottom: -.5rem;
  }

  .cocreate__statement-heading {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--font-size-h2);
    color: var(--cocreate-heading-color, rgb(var(--color-heading)));
    margin: 0 0 1rem;
  }

  .cocreate__statement-body {
    font-size: var(--font-size-body);
    line-height: var(--line-height-base);
    color: rgba(var(--color-text), .75);
  }

  /* ---- Value props (bento grid) ---- */
  .cocreate__values {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: var(--cocreate-block-gap, 4rem);
  }

  .cocreate__value {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgb(var(--color-border));
    background: rgb(var(--color-background-alt));
    transition: transform var(--transition-medium), box-shadow var(--transition-medium), border-color var(--transition-medium);
  }

  .cocreate__value:hover {
    transform: translateY(-4px);
    border-color: var(--cocreate-accent-color, rgb(var(--color-accent)));
    box-shadow: 0 16px 32px rgba(0, 0, 0, .08);
  }

  .cocreate__value--featured {
    grid-column: span 2;
  }

  .cocreate__value--with-image {
    padding: 0;
    overflow: hidden;
  }

  .cocreate__value-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .cocreate__value-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-medium);
  }

  .cocreate__value:hover .cocreate__value-media img {
    transform: scale(1.05);
  }

  .cocreate__value--with-image .cocreate__value-copy {
    padding: 1.5rem;
  }

  .cocreate__value-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 1rem;
    border-radius: 50%;
    background: rgb(var(--color-background));
    font-size: 1.25rem;
  }

  .cocreate__value-lead {
    display: block;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--font-size-h3);
    margin-bottom: .375rem;
  }

  .cocreate__value-text {
    font-size: var(--font-size-small);
    line-height: var(--line-height-base);
    color: rgba(var(--color-text), .75);
  }

  /* ---- Process flow (vertical timeline) ---- */
  .cocreate__section-heading {
    text-align: center;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--font-size-h2);
    color: var(--cocreate-heading-color, rgb(var(--color-heading)));
    margin: 0 0 2rem;
  }

  .cocreate__section-subheading {
    text-align: center;
    font-size: var(--font-size-body);
    color: rgba(var(--color-text), .75);
    max-width: 34rem;
    margin: -1rem auto 2rem;
  }

  .cocreate__process {
    display: flex;
    flex-direction: column;
    max-width: 44rem;
    margin: 0 auto var(--cocreate-block-gap, 4rem);
  }

  .cocreate__step {
    display: flex;
    gap: 1.5rem;
    padding-bottom: 2.5rem;
  }

  .cocreate__step-rail {
    order: 0;
    flex: 0 0 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cocreate__step-media {
    order: 1;
    flex: 0 0 6rem;
    width: 6rem;
    height: 6rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .cocreate__step-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cocreate__step-copy {
    order: 2;
    flex: 1;
    min-width: 0;
    padding-top: .25rem;
  }

  .cocreate__step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--cocreate-accent-color, rgb(var(--color-accent)));
    color: var(--cocreate-accent-color, rgb(var(--color-accent)));
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--font-size-small);
  }

  .cocreate__step-line {
    flex: 1;
    width: 2px;
    margin-top: .5rem;
    background: rgb(var(--color-border));
    transition: background var(--transition-medium) .15s;
  }

  .cocreate__step.is-revealed .cocreate__step-line {
    background: var(--cocreate-accent-color, rgb(var(--color-accent)));
  }

  .cocreate__step--last .cocreate__step-line {
    display: none;
  }

  .cocreate__step-title {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--font-size-h3);
    margin: 0 0 .375rem;
  }

  .cocreate__step-subtitle {
    font-size: var(--font-size-small);
    color: var(--cocreate-accent-color, rgb(var(--color-accent)));
    margin: 0 0 .75rem;
  }

  .cocreate__step-description {
    font-size: var(--font-size-small);
    line-height: var(--line-height-base);
    color: rgba(var(--color-text), .75);
  }

  /* ---- Testimonial (layered depth card) ---- */
  .cocreate__testimonial-wrap {
    position: relative;
    max-width: 42rem;
    margin: 0 auto var(--cocreate-block-gap, 4rem);
    padding-top: 1.5rem;
  }

  .cocreate__testimonial-shape {
    position: absolute;
    inset: 1.5rem -1rem -1rem 1rem;
    background: rgba(var(--color-accent), .08);
    border-radius: var(--radius-lg);
    z-index: 0;
  }

  .cocreate__testimonial-portrait {
    position: relative;
    z-index: 2;
    width: 4.5rem;
    height: 4.5rem;
    margin: 0 auto -2.5rem;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid rgb(var(--color-background));
    box-shadow: 0 8px 20px rgba(0, 0, 0, .14);
  }

  .cocreate__testimonial-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cocreate__testimonial {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 3rem 2rem;
    background: rgb(var(--color-background));
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 40px rgba(0, 0, 0, .06);
  }

  .cocreate__testimonial-wrap:has(.cocreate__testimonial-portrait) .cocreate__testimonial {
    padding-top: 3.5rem;
  }

  .cocreate__testimonial-quote {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--font-size-h2);
    line-height: 1.4;
    margin: 0 0 1rem;
  }

  .cocreate__testimonial-attribution {
    display: block;
    font-style: normal;
    font-size: var(--font-size-caption);
    text-transform: uppercase;
    letter-spacing: .08em;
    color: rgba(var(--color-text), .6);
  }

  /* ---- Spotlight CTA ---- */
  .cocreate__spotlight {
    display: grid;
    grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
    margin-bottom: var(--cocreate-block-gap, 4rem);
  }

  .cocreate__spotlight--no-image {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .cocreate__spotlight-media {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .cocreate__spotlight-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cocreate__spotlight-media--stacked {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: visible;
  }

  .cocreate__spotlight-media-back {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    opacity: .85;
    transform: translate(10%, 7%) rotate(4deg);
    transition: transform var(--transition-medium);
  }

  .cocreate__spotlight-media--stacked .cocreate__spotlight-media-front {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition-medium);
  }

  .cocreate__spotlight-media--stacked:hover .cocreate__spotlight-media-back {
    transform: translate(14%, 10%) rotate(6deg);
  }

  .cocreate__spotlight-media--stacked:hover .cocreate__spotlight-media-front {
    transform: translate(-3%, -3%);
  }

  .cocreate__spotlight-badge {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .625rem 1rem;
    background: rgb(var(--color-background));
    border-radius: var(--radius-full);
    box-shadow: 0 12px 24px rgba(0, 0, 0, .12);
  }

  .cocreate__spotlight-badge-icon {
    font-size: 1.1rem;
  }

  .cocreate__spotlight-badge-title {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--font-size-small);
  }

  .cocreate__spotlight-subtext {
    font-size: var(--font-size-small);
    color: rgba(var(--color-text), .7);
    margin: 0 0 1rem;
  }

  .cocreate__spotlight-benefits {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin: 0 0 1rem;
  }

  .cocreate__spotlight-benefits li {
    padding: .375rem .875rem;
    border-radius: var(--radius-full);
    border: 1px solid rgb(var(--color-border));
    font-size: var(--font-size-caption);
  }

  .cocreate__spotlight--no-image .cocreate__spotlight-benefits {
    justify-content: center;
  }

  .cocreate__spotlight-closing {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--font-size-h3);
    line-height: 1.4;
    margin: 0 0 .5rem;
  }

  .cocreate__spotlight-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .cocreate__spotlight--no-image .cocreate__spotlight-actions {
    justify-content: center;
  }

  .cocreate__spotlight-secondary-link {
    font-size: var(--font-size-small);
    text-decoration: underline;
    color: rgba(var(--color-text), .7);
  }

  /* ---- Privacy grid (glassmorphism) ---- */
  .cocreate__privacy-section {
    position: relative;
    padding: 3rem 2rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--cocreate-block-gap, 4rem);
    background: rgb(var(--color-background-alt));
  }

  .cocreate__privacy-texture {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: .5;
    background-image: radial-gradient(rgba(var(--color-accent), .35) 1px, transparent 1px);
    background-size: 22px 22px;
  }

  .cocreate__privacy-section .cocreate__section-heading,
  .cocreate__privacy-section .cocreate__section-subheading {
    position: relative;
    z-index: 1;
  }

  .cocreate__privacy-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .cocreate__privacy-item {
    text-align: center;
    padding: 1.75rem 1.25rem;
    background: rgba(var(--color-background), .6);
    border: 1px solid rgba(var(--color-text), .08);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(10px);
    transition: transform var(--transition-medium), box-shadow var(--transition-medium);
  }

  .cocreate__privacy-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(0, 0, 0, .1);
  }

  .cocreate__privacy-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    margin: 0 auto 1rem;
    border-radius: 50%;
    background: rgb(var(--color-background));
    font-size: 1.4rem;
  }

  .cocreate__privacy-title {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: .04em;
    margin: 0 0 .5rem;
  }

  .cocreate__privacy-text {
    font-size: var(--font-size-caption);
    line-height: var(--line-height-base);
    color: rgba(var(--color-text), .7);
  }

  /* ---- FAQ ---- */
  .cocreate__faq {
    max-width: 42rem;
    margin: 0 auto var(--cocreate-block-gap, 4rem);
  }

  .cocreate__faq-item {
    border-bottom: 1px solid rgb(var(--color-border));
  }

  .cocreate__faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: var(--font-size-body);
  }

  .cocreate__faq-question::-webkit-details-marker {
    display: none;
  }

  .cocreate__faq-toggle {
    flex-shrink: 0;
    position: relative;
    width: 1rem;
    height: 1rem;
  }

  .cocreate__faq-toggle::before,
  .cocreate__faq-toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: currentColor;
    transition: transform var(--transition-fast);
  }

  .cocreate__faq-toggle::before {
    width: 100%;
    height: 1px;
    transform: translate(-50%, -50%);
  }

  .cocreate__faq-toggle::after {
    width: 1px;
    height: 100%;
    transform: translate(-50%, -50%);
  }

  .cocreate__faq-item[open] .cocreate__faq-toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }

  .cocreate__faq-answer {
    padding-bottom: 1.25rem;
    font-size: var(--font-size-small);
    line-height: var(--line-height-base);
    color: rgba(var(--color-text), .75);
  }

  /* ---- Standalone CTA banner ---- */
  .cocreate__cta-banner {
    position: relative;
    text-align: center;
    padding: 2.5rem 2rem;
    margin-bottom: var(--cocreate-block-gap, 4rem);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .cocreate__cta-banner-glow {
    position: absolute;
    inset: -60% -10%;
    z-index: 0;
    background: radial-gradient(ellipse at center, rgba(var(--color-accent), .12), transparent 65%);
    animation: cocreate-blob-float 20s ease-in-out infinite;
  }

  .cocreate__cta-banner .action--primary {
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 59.99em) {
    .cocreate__hero,
    .cocreate__hero--with-image {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }

    .cocreate__hero-media {
      flex: none;
      width: 100%;
      max-width: 22rem;
      align-self: center;
    }

    .cocreate__stat--floating {
      left: 1rem;
    }

    .cocreate__stat--inline {
      text-align: left;
      padding-left: 0;
      border-left: 0;
      padding-top: 1.5rem;
      border-top: 1px solid rgb(var(--color-border));
    }

    .cocreate__heading {
      font-size: var(--font-size-h1-mobile);
    }

    .cocreate__values,
    .cocreate__privacy-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cocreate__value--featured {
      grid-column: span 2;
    }

    .cocreate__spotlight {
      grid-template-columns: 1fr;
    }

    .cocreate__statement--with-image {
      padding-left: 0;
      padding-top: 3.5rem;
      text-align: center;
    }

    .cocreate__statement-media {
      left: 50%;
      transform: translateX(-50%) rotate(-4deg);
    }

    .cocreate__statement--with-image .cocreate__statement-copy {
      text-align: center;
    }
  }

  @media screen and (max-width: 44.99em) {
    .cocreate__values,
    .cocreate__privacy-grid {
      display: flex;
      grid-template-columns: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 1rem;
      padding-bottom: .5rem;
      margin-inline: -1rem;
      padding-inline: 1rem;
    }

    .cocreate__value,
    .cocreate__privacy-item {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }

    .cocreate__value--featured {
      grid-column: unset;
    }

    .cocreate__step {
      gap: 1rem;
    }

    .cocreate__step-media {
      flex: 0 0 4.5rem;
      width: 4.5rem;
      height: 4.5rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll('[data-cocreate-stat]').forEach(function (el) {
      var target = el.dataset.cocreateStat || '';
      var numericMatch = target.match(/[\d,]+/);
      if (!numericMatch || prefersReducedMotion) return;

      var targetNumber = parseInt(numericMatch[0].replace(/,/g, ''), 10);
      if (!targetNumber) return;

      var prefix = target.slice(0, numericMatch.index);
      var suffix = target.slice(numericMatch.index + numericMatch[0].length);
      var hasAnimated = false;

      var animate = function () {
        if (hasAnimated) return;
        hasAnimated = true;
        var startTime = null;
        var duration = 1200;
        var step = function (timestamp) {
          if (!startTime) startTime = timestamp;
          var progress = Math.min((timestamp - startTime) / duration, 1);
          var current = Math.floor(progress * targetNumber);
          el.textContent = prefix + current + suffix;
          if (progress < 1) {
            window.requestAnimationFrame(step);
          } else {
            el.textContent = target;
          }
        };
        window.requestAnimationFrame(step);
      };

      var observer = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) {
          animate();
          observer.disconnect();
        }
      });
      observer.observe(el);
    });

    document.querySelectorAll('.cocreate__faq').forEach(function (container) {
      var items = Array.prototype.slice.call(container.querySelectorAll('details.cocreate__faq-item'));
      items.forEach(function (details) {
        details.addEventListener('toggle', function () {
          if (details.open) {
            items.forEach(function (other) {
              if (other !== details) other.removeAttribute('open');
            });
          }
        });
      });
    });
  })();
{% endjavascript %}

